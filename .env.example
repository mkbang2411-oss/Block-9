# Supabase -> Project Settings -> Database -> Connection string (nên dùng Session pooler, port 5432)
DATABASE_URL=postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
PORT=3000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CORS cho REST API (/api): các origin của frontend được phép gọi, phân tách bằng dấu phẩy.
# Bỏ trống = chỉ cho các origin dev thông dụng (localhost:3000/5173/4200/5500).
# Không nên đặt "*" khi API có thao tác cần đăng nhập.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Postgres ở localhost tự tắt SSL. Đặt false để ép tắt SSL ở máy khác (Supabase: để trống = bật SSL).
# DB_SSL=false

# ---- Xác thực JWT (bắt buộc) ----
# Chuỗi ngẫu nhiên >= 32 byte, KHÔNG commit. Tạo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Thời hạn access token (vd 15m, 5s để thử TOKEN_EXPIRED). Không có refresh token.
JWT_EXPIRES_IN=15m
NODE_ENV=development
# ---- MFA TOTP (Đợt 4) ----
# Khóa mã hóa khóa TOTP + HMAC mã khôi phục trong DB (>= 32 byte). Không đặt thì dẫn xuất từ JWT_SECRET (tiện dev).
# Chạy thật: đặt khóa RIÊNG và KHÔNG đổi sau khi đã có người bật MFA (đổi = mọi MFA cũ vô dụng).
MFA_ENCRYPTION_KEY=
# Tên hiển thị trong app Authenticator (mặc định: Cái Quán Ăn)
MFA_ISSUER=
# URL công khai của SPA (dùng trong link email đặt lại mật khẩu và kiểm tra hostname reCAPTCHA)
APP_URL=http://localhost:3000
# Chạy sau reverse proxy (Render...): đặt 1 để req.ip là IP thật (rate limit theo IP)
# TRUST_PROXY=1

# ---- Gửi email OTP / đặt lại mật khẩu (Đợt 2): SMTP hoặc Resend; dev: DEV_PRINT_MAIL=1 để in thư ra console ----
MAIL_FROM="Cái Quán Ăn <no-reply@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
DEV_PRINT_MAIL=

# ---- reCAPTCHA v2 (để trống khi dev: bỏ qua kiểm tra; production: bắt buộc, thiếu thì từ chối) ----
# Lấy khóa THẬT: https://www.google.com/recaptcha/admin/create -> chọn "reCAPTCHA v2" + "Hộp kiểm Tôi không phải người máy",
# thêm tên miền "localhost" (và tên miền thật khi deploy). SITE_KEY hiện ra ở web, SECRET_KEY chỉ để ở server.
# (Khóa TEST của Google luôn cho qua, KHÔNG chặn bot: chỉ để thử giao diện.)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_HOSTNAMES=

# Mã mời để đăng ký thẳng thành editor (Đợt 2). Để trống = không ai đăng ký được editor bằng mã.
CHEF_INVITE_CODE=

# Mật khẩu 3 tài khoản mẫu của npm run db:seed:users
SEED_PASSWORD=
